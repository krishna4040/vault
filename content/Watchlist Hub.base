views:
  - type: cards
    name: Series
    filters:
      and:
        - file.folder == "MediaDB/Series"
    groupBy:
      property: watched
      direction: ASC
    order: []
    sort: []
    image: note.image
    imageAspectRatio: 1.55
    cardSize: 240
    consolidateStatusIcon: false
    explodeListColumns: false
  - type: cards
    name: Movies
    filters:
      and:
        - file.folder == "MediaDB/Movies"
    groupBy:
      property: genres
      direction: ASC
    order: []
    sort:
      - property: onlineRating
        direction: DESC
    image: note.image
    imageAspectRatio: 1.55
    cardSize: 240
  - type: cards
    name: Books
    filters:
      and:
        - file.folder == "MediaDB/Books"
    groupBy:
      property: read
      direction: ASC
    order: []
    sort:
      - property: onlineRating
        direction: DESC
    image: note.image
    imageAspectRatio: 1.55
    cardSize: 240
    consolidateStatusIcon: false
    explodeListColumns: false
