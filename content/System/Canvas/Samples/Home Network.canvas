      "width": 796,
      "x": 5,
      "y": -920
    },
    {
      "file": "Samples/media/home-netowrk/repater-cc-image.svg",
      "height": 127,
      "id": "5481d326de5a649b",
      "type": "file",
      "width": 90,
      "x": 153,
      "y": -173
    },
    {
      "height": 175,
      "id": "034ff976885334da",
      "text": "---\ncssclasses: cc-card-gradient-0deg, cc-border-none, cc-border-squared\n---\n##### 8-port gigabit ethernet\n\nMy 8-port gigabit ethernet switch has also been a worthwhile investment. I have it connected to one of the router's LAN ports so I can run ethernet cables from the switch to devices in other rooms like my home office.\n",
      "type": "text",
      "width": 537,
      "x": -200,
      "y": 53
    }
  ]
